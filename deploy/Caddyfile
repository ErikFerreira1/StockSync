{$SITE_ADDRESS} {
	encode zstd gzip

	handle /api {
		redir * /api/ 308
	}

	handle_path /api/* {
		reverse_proxy app:8080 {
			header_up X-Forwarded-Prefix /api
		}
	}

	handle /swagger-ui.html {
		redir * /api/swagger-ui.html 302
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
