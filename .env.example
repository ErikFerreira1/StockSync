# The defaults below are for the local demo only. Replace every secret before hosting.
SPRING_PROFILES_ACTIVE=demo
APP_PORT=8080

POSTGRES_DB=stocksync
POSTGRES_USER=stocksync
POSTGRES_PASSWORD=stocksync-demo-db
POSTGRES_PORT=5432

SHOW_SQL=false
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_SECRET=demo-only-jwt-secret-with-at-least-32-bytes

DEMO_USERNAME=demo
DEMO_PASSWORD=stocksync-demo

# Required when running without the demo profile.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
MERCADO_LIVRE_REDIRECT_URI=https://your-domain.example/mercadolivre/callback
